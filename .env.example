# Local server settings. Copy to .env and fill values privately; never commit .env.
# Node 24+ is required for built-in SQLite.
PORT=3001
DATA_DIR=.data
DATA_SEED=true

# Set BOTH role passwords before sharing this app with real company data.
# With no passwords configured, the app is an explicitly labelled demo.
APP_OWNER_PASSWORD=
APP_MANAGER_PASSWORD=

# OpenAI is optional for business operations. API billing is separate from ChatGPT.
# POTSHAVEN_OPENAI_KEY also supports a managed environment proxy binding.
POTSHAVEN_OPENAI_KEY=
POTSHAVEN_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=max
OPENAI_IMAGE_SIZE=2560x1440
